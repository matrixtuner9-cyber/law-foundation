   "text": "يا زلمة، مبارح كانت عندي مهلة استئناف، وما انتبهت إلا آخر يوم!"
  },
  {
   "sp": "A",
   "i": 0,
   "src": [
    0,
    2.44
   ],
   "t0": 5.99,
   "t1": 8.43,
   "text": "ليش؟ ما في حدا بيذكّرك؟"
  },
  {
   "sp": "B",
   "i": 1,
   "src": [
    5.24,
