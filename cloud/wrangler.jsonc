{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mithaq",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // كل الطلبات تمر بالـ Worker أولاً: الملفات الثابتة لشاشة المحامي لا تُقدَّم إلا بعد التحقق من الجلسة
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "OFFICE", "class_name": "Office" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Office"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "mithaq-central", "database_id": "2563959c-dd27-47d0-b5b7-da2570e44c5f", "migrations_dir": "schema" },
    // قاعدة «مِسْبار» (التشريعات والقرارات) للقراءة فقط، تُحدَّث بالاستيراد من misbar/mithaq-lawindex.sql
    { "binding": "LAWINDEX", "database_name": "mithaq-lawindex", "database_id": "a9bf27e1-2479-44e2-9acd-651fbfc0d1f0" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "mithaq-media" }],
  "vars": { "BASE_DOMAINS": "palgaz.net", "OPS_HOSTS": "test.palgaz.net", "LICENSE_PUB": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAM+BLUCow1xx43+hQVivH+yW+Z6+6/AsSbBUYBEZtv34=\n-----END PUBLIC KEY-----\n", "ACTIVATION_PUB": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAsPHNDrosTEu/QqZv2vTk+58dBCsq45kHHt76b/VhoKI=\n-----END PUBLIC KEY-----\n" },
  // نسخة احتياطية مشفّرة يومياً الساعة 03:30 بتوقيت فلسطين (00:30 UTC). تتطلب السر BACKUP_KEY
  "triggers": { "crons": ["30 0 * * *", "7 * * * *"] },
  // كل مكتب نطاق مخصص (Custom Domain) يُنشئ سجل DNS وشهادة تلقائياً
  "routes": [{ "pattern": "test.palgaz.net", "custom_domain": true }, { "pattern": "demo.palgaz.net", "custom_domain": true }, { "pattern": "misbar.palgaz.net", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
  // الأسرار (لا تُكتب هنا): OPS_TOKEN وBACKUP_KEY وACT_PRIV (مفتاح التفعيل الخاص) عبر: wrangler secret put <الاسم>
}
