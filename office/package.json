{
  "name": "mithaq",
  "version": "2.0.0",
  "private": true,
  "description": "ميثاق - نظام إدارة مكتب المحاماة",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "icon": "node electron/make-icon.js",
    "dist": "electron-builder --win nsis portable",
    "dist:private": "node tools/build-private.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "playwright-core": "^1.48.2",
    "web-push": "^3.6.7"
  },
  "productName": "Mithaq",
  "author": "Mithaq Law Office",
  "build": {
    "appId": "ps.mithaq.desktop",
    "productName": "Mithaq",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server.js",
      "data.js",
      "index.html",
      "app.js",
      "dash.js",
      "briefcase.js",
      "sync.js",
      "mizan-ui.js",
      "style.css",
      "dash.css",
      "briefcase.css",
      "mizan.css",
      "mizan/**",
      "portal/**",
      "lib/**",
      "admin.js",
      "admin.css",
      "prestige.css",
      "login.html",
      "login.css",
      "login.js",
      "scales.js",
      "phase2.js",
      "phase2.css",
      "bar/**",
      "bar.js",
      "bar.css",
      "responsive.js",
      "responsive.css",
      "package.json",
      "node_modules/**",
      "!data/**",
      "!mithaq_portal/**",
      "!tools/**",
      "!dist/**",
      "!dist-private/**",
      "print.js",
      "intake.js",
      "rulings.js",
      "maqamsearch.js",
      "sources.js",
      "legal-shelf.js",
      "ready-templates-palestine.js",
      "guide.js",
      "fonts/**",
      "edition.js",
      "edition.json",
      "lawlib-data.js",
      "lawlib.js",
      "legislation.js",
      "aidraft.js",
      "calc-engine.js",
      "calc.js",
      "hdr-banner.jpg",
      "hdr-side.jpg",
      "hdr-side.webp",
      "hdr-emblem.jpg",
      "hdr-logo.jpg"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ميثاق",
      "artifactName": "methaq-found-ver2.0-Setup.${ext}"
    },
    "portable": {
      "artifactName": "methaq-found-ver2.0-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
