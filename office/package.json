{
  "name": "mithaq",
  "version": "1.0.0",
  "private": true,
  "description": "المِسْبار - نظام إدارة مكتب المحاماة وعقل القانون",
  "main": "electron/boot.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "icon": "node electron/make-icon.js",
    "dist": "electron-builder --win nsis portable",
    "dist:private": "node tools/build-private.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "playwright-core": "^1.48.2",
    "web-push": "^3.6.7"
  },
  "productName": "Misbar",
  "author": "Misbar Law Systems",
  "build": {
    "appId": "ps.misbar.desktop",
    "productName": "Misbar",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "*.js",
      "*.css",
      "*.html",
      "*.json",
      "*.jpg",
      "*.webp",
      "*.png",
      "lib/**",
      "mizan/**",
      "bar/**",
      "fonts/**",
      "vendor/**",
      "portal/**",
      "node_modules/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/app-builder-lib/**",
      "!node_modules/app-builder-bin/**",
      "!node_modules/dmg-builder/**",
      "!node_modules/@electron/**",
      "!node_modules/7zip-bin/**",
      "!node_modules/builder-util/**",
      "!node_modules/builder-util-runtime/**",
      "!node_modules/electron-publish/**",
      "!node_modules/.cache/**",
      "!data/**",
      "!backups/**",
      "!MithaqBackups/**",
      "!mithaq_portal/**",
      "!tools/**",
      "!tests/**",
      "!dist/**",
      "!dist-private/**",
      "!*.bat",
      "!*.py",
      "!*.vbs",
      "!patch*",
      "!_bak*/**",
      "!_new/**",
      "!edition.json",
      "license.pub",
      "activation.pub"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.ico",
      "artifactName": "Misbar-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "المِسْبار",
      "artifactName": "Misbar-Setup-${version}.${ext}",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "language": "1025",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico"
    },
    "portable": {
      "artifactName": "Misbar-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "data/mithaq-lawindex.db",
        "to": "lawindex/mithaq-lawindex.db"
      },
      {
        "from": "data/bar/lawyers.json",
        "to": "bar/lawyers.json"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
